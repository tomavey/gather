rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /emails/{emailId} {
      allow get: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow list, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['to', 'subject', 'text', 'html', 'inviteId', 'createdBy'])
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() < 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() < 200
        && request.resource.data.text is string
        && request.resource.data.text.size() < 8000
        && request.resource.data.inviteId is string
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteId))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteId)).data.email == request.resource.data.to;
    }

    match /{collection}/{docId} {
      allow read, write: if request.auth != null && collection != 'emails';
    }
  }
}
