# Firebase web app config (Firebase console → Project settings → General → Your apps).
# Copy this file to .env and restart the dev server.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional. Service account used for server-side Auth during local SSR.
# Download it from Project settings → Service accounts → Generate new private key.
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
